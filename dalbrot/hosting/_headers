# Security headers for hosting the single-file app on your own domain
# (Netlify and Cloudflare Pages read this file as-is).
# The policy allows only what the app uses: its own inline script and styles,
# bundled data: fonts and blob: photo previews. It blocks every network request,
# so even a script-injection bug could not send a user's log anywhere.
/*
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; font-src data:; img-src 'self' data: blob:; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
